  "options": {
    "step": {
      "init": {
        "title": "Report runs",
        "description": "Pick a smart device from the app to link the entities that tell the integration when it ran and what it used. Choose Done to save.",
        "data": {
          "load": "Device"
        }
      },
      "load": {
        "title": "{load}",
        "description": "Running entity: a switch, binary sensor or status sensor that is on/run while {load} runs. Energy entity: a kWh total or a power in W (a smart plug, for instance). Without a running entity, power above the threshold means running. Leave both empty to unlink the device.",
        "data": {
          "running_entity": "Running entity",
          "energy_entity": "Energy entity (kWh or W)",
          "threshold_w": "Threshold for 'running' (W, power sensor only)"
        }
      }
    },
    "error": {
      "kwh_needs_running": "A kWh total does not tell when the device runs: add a running entity, or use a power sensor (W)."
    },
    "abort": {
      "no_smart_loads": "No smart devices yet: switch them on in the app under Account > Slimme apparaten first (the integration sees it within five minutes)."
    }
