  "services": {
    "meld_apparaat": {
      "name": "Report run",
      "description": "Tells Mijn SlimStroom that a smart device ran, for your own automations without the link in the options.",
      "fields": {
        "load_id": {
          "name": "Device id",
          "description": "The device id as in the app (for example boiler)."
        },
        "started_at": {
          "name": "Started at",
          "description": "Start of the run."
        },
        "ended_at": {
          "name": "Ended at",
          "description": "End of the run; empty = still running."
        },
        "kwh": {
          "name": "Energy (kWh)",
          "description": "Measured energy of this run; empty = estimate from the settings."
        }
      }
    }
  }
